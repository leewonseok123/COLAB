    {
      "cell_type": "code",
      "source": [
        "# @title ## **2. 생성된 이미지 다운로드 (Download Generated Images)**\\n",
        "# @markdown > 이 셀을 실행하면 구글 드라이브의 `outputs` 폴더에 있는 모든 이미지를 압축하여 로컬로 다운로드하거나, 다른 드라이브 폴더로 복사할 수 있습니다.\\n",
        "import zipfile\\n",
        "from pathlib import Path\\n",
        "from google.colab import files, auth\\n",
        "from pydrive.auth import GoogleAuth\\n",
        "from pydrive.drive import GoogleDrive\\n",
        "from oauth2client.client import GoogleCredentials\\n",
        "\\n",
        "# @markdown ### **압축 및 저장 설정 (Zip & Save Config)**\\n",
        "save_to_drive = False  # @param {type:\\"boolean\\"}\\n",
        "drive_folder_name = \\"My_Forge_Images\\"  # @param {type: \\"string\\"}\\n",
        "zip_filename = \\"forge_outputs.zip\\"  # @param {type: \"string\"}\\n",
        "\\n",
        "def get_unique_filename(base_path):\\n",
        "    \\"\\"\\"동일한 이름의 파일이 있으면 (1), (2) 등을 붙여서 고유한 파일명을 반환합니다.\\"\\"\\"\\n",
        "    path = Path(base_path)\\n",
        "    if not path.exists():\\n",
        "        return path\\n",
        "    i = 1\\n",
        "    while True:\\n",
        "        new_path = path.with_name(f\\"{path.stem}({i}){path.suffix}\\")\\n",
        "        if not new_path.exists():\\n",
        "            return new_path\\n",
        "        i += 1\\n",
        "\\n",
        "def zip_directory(directory, zip_path):\\n",
        "    \\"\\"\\"지정된 폴더를 압축합니다.\\"\\"\\"\\n",
        "    with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:\\n",
        "        for file_path in directory.rglob('*'):\\n",
        "            if file_path.is_file():\\n",
        "                zipf.write(file_path, file_path.relative_to(directory.parent))\\n",
        "\\n",
        "try:\\n",
        "    # 결과물 폴더 경로\\n",
        "    outputs_path = workspace_dir / output_drive_folder\\n",
        "    # 압축 파일을 저장할 임시 경로\\n",
        "    local_zip_path = root_dir / get_unique_filename(zip_filename).name\\n",
        "\\n",
        "    if not outputs_path.exists() or not any(outputs_path.iterdir()):\\n",
        "        cprint(\\"No images found in the outputs folder.\\", color=\\"yellow\\")\\n",
        "    else:\\n",
        "        cprint(f\\"Zipping contents of {outputs_path}...\\", color=\\"green\\")\\n",
        "        zip_directory(outputs_path, local_zip_path)\\n",
        "        cprint(f\\"Successfully created zip file: {local_zip_path.name}\\", color=\\"green\\")\\n",
        "\\n",
        "        if save_to_drive:\\n",
        "            cprint(\\"Uploading zip file to your Google Drive...\\", color=\\"green\\")\\n",
        "            auth.authenticate_user()\\n",
        "            gauth = GoogleAuth()\\n",
        "            gauth.credentials = GoogleCredentials.get_application_default()\\n",
        "            drive_service = GoogleDrive(gauth)\\n",
        "\\n",
        "            # 지정된 이름의 폴더가 없으면 생성\\n",
        "            query = f\\"title='{drive_folder_name}' and mimeType='application/vnd.google-apps.folder' and trashed=false\\"\\n",
        "            file_list = drive_service.ListFile({'q': query}).GetList()\\n",
        "            if file_list:\\n",
        "                folder_id = file_list[0]['id']\\n",
        "            else:\\n",
        "                folder_metadata = {'title': drive_folder_name, 'mimeType': 'application/vnd.google-apps.folder'}\\n",
        "                folder = drive_service.CreateFile(folder_metadata)\\n",
        "                folder.Upload()\\n",
        "                folder_id = folder['id']\\n",
        "\\n",
        "            # 압축 파일 업로드\\n",
        "            file_metadata = {'title': local_zip_path.name, 'parents': [{'id': folder_id}]}\\n",
        "            drive_file = drive_service.CreateFile(file_metadata)\\n",
        "            drive_file.SetContentFile(str(local_zip_path))\\n",
        "            drive_file.Upload()\\n",
        "            cprint(f\\"Successfully uploaded '{local_zip_path.name}' to '{drive_folder_name}' folder in your Google Drive.\\", color=\\"green\\")\\n",
        "            os.remove(local_zip_path) # 로컬 임시 파일 삭제\\n",
        "        else:\\n",
        "            cprint(\\"Downloading zip file to your local machine...\\", color=\\"green\\")\\n",
        "            files.download(str(local_zip_path))\\n",
        "except NameError:\\n",
        "    cprint(\\"Please run the main setup cell first!\\", color=\\"red\\")\\n",
        "except Exception as e:\\n",
        "    cprint(f\\"An error occurred: {e}\\", color=\\"red\\")"
      ],
      "metadata": {
